{
  "name": "dsh-teleagent",
  "version": "1.0.0",
  "description": "TeleAgent 档位模型接入 DSH：工具调用、可配置上下文（含 1M）、插件内官方登录。TeleAgent tier models for DeepSeek Harness with tool calling and in-panel sign-in.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "DELIVERY.md",
    "regression.mjs",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KUMAKAIHA/dsh-teleagent.git"
  },
  "bugs": {
    "url": "https://github.com/KUMAKAIHA/dsh-teleagent/issues"
  },
  "homepage": "https://github.com/KUMAKAIHA/dsh-teleagent#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "teleagent",
    "llm",
    "openai-compatible",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node regression.mjs",
    "prepublishOnly": "node regression.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
